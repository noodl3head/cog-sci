# This gets filled in automatically by Vercel when you add a Neon Postgres
# integration from the Marketplace. For local development, run:
#   vercel env pull .env.local
# to copy it down, or paste your Neon connection string here manually.
DATABASE_URL=postgres://user:***@host/dbname?sslmode=require

# Dedicated private Telegram bot for the daily 12:00 PM IST mock.
# Create the bot with @BotFather and set these in Vercel; never commit real values.
TELEGRAM_MOCK_BOT_TOKEN=123456789:replace-with-botfather-token
TELEGRAM_MOCK_ALLOWED_USER_ID=replace-with-your-numeric-telegram-user-id
TELEGRAM_MOCK_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_MOCK_SETUP_SECRET=replace-with-a-different-long-random-secret
CRON_SECRET=replace-with-a-third-long-random-secret
NEXT_PUBLIC_APP_URL=https://your-cog-sci-domain.example
